default_platform(:ios)

platform :ios do
  desc "Baut TrainSammler und lädt den Build zu TestFlight hoch"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: false,
      in_house: false
    )

    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    import_certificate(
      certificate_path: "certificate.p12",
      certificate_password: ENV.fetch("P12_PASSWORD"),
      keychain_name: "ci_keychain",
      keychain_password: "ci_password"
    )

    # Lädt das passende App-Store-Provisioning-Profile automatisch über die API
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "de.amon.trainSammler",
      output_path: "fastlane"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "trainSammler.xcodeproj",
      team_id: "79T386JC4J",
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::SIGH_NAME]
    )

    build_app(
      scheme: "trainSammler",
      project: "trainSammler.xcodeproj",
      export_method: "app-store",
      clean: true,
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "de.amon.trainSammler" => lane_context[SharedValues::SIGH_NAME]
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )

    delete_keychain(name: "ci_keychain")
  end
end
